{
  "manifest_version": 3,
  "name": "Bili 4K 拉流助手",
  "version": "1.1.0",
  "description": "在 B 站视频页选择清晰度，通过自建后端取流并拉起 mpv / PotPlayer 播放。",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bili 4K 拉流助手设置"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
